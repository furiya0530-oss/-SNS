# このファイルを .env.local にコピーして、実際の値を設定してください。
# .env.local は .gitignore 対象なのでコミットされません。
# VITE_ プレフィックスの変数はビルド結果に埋め込まれ、ブラウザから参照できます。
# 秘密鍵 (Supabase の service_role キーや Stripe のシークレットキー) は絶対に置かないでください。

# --- Supabase ---
# Supabase ダッシュボード > Project Settings > API から取得
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Stripe (フェーズ2の決済機能で使用) ---
# Stripe ダッシュボード > 開発者 > API キー の「公開可能キー」
VITE_STRIPE_PUBLISHABLE_KEY=
