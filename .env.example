# このファイルを .env.local にコピーして、実際の値を設定してください。
# .env.local は .gitignore 対象なのでコミットされません。
# VITE_ プレフィックスの変数はビルド結果に埋め込まれ、ブラウザから参照できます。
# 秘密鍵 (Supabase の service_role キーや Stripe のシークレットキー) は絶対に置かないでください。

# --- Supabase ---
# Supabase ダッシュボード > Project Settings > API から取得
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Stripe ---
# Stripe ダッシュボード > 開発者 > API キー の「公開可能キー」
# 現在は Stripe Checkout へリダイレクトする方式のため未使用。
# フロントで Stripe.js を使う場合に設定する。
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Edge Function 側の秘密鍵 (このファイルではなく supabase secrets に登録する) ---
# supabase secrets set STRIPE_SECRET_KEY=sk_...
# supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
# supabase secrets set STRIPE_PRICE_ID=price_...
# supabase secrets set APP_URL=https://<本番URL>
